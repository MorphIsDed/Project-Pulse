# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PROJECTPULSE_ENV=production
PROJECTPULSE_SECRET_KEY=replace-with-a-long-random-secret
PROJECTPULSE_TRUSTED_HOSTS=projects.example.com
PROJECTPULSE_ALLOWED_ORIGINS=https://projects.example.com
PROJECTPULSE_COOKIE_SECURE=1
PROJECTPULSE_DATABASE=/data/projectpulse.sqlite3
