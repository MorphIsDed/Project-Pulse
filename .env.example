# Copy this file to .env and adjust values for local development.
# Never commit .env.

# Flask session signing key. Replace with a long random value outside development.
SECRET_KEY=development-only-change-me

# SQLAlchemy database URI. A relative SQLite path resolves under backend/instance/.
DATABASE_URL=sqlite:///projectpulse.sqlite3

# development | testing | production
APP_ENV=development

# Public account registration is disabled until the demo phase is complete.
ALLOW_PUBLIC_SIGNUP=false

# Password assigned to the seeded demo accounts by `flask seed-demo`.
DEMO_PASSWORD=DemoPulse123!

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
