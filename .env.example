# Copy to .env and replace the secret with: python -c "import secrets; print(secrets.token_hex(32))"
APP_DOMAIN=projects.example.com
PROJECTPULSE_SECRET_KEY=replace-with-at-least-32-random-characters
ALLOW_PUBLIC_SIGNUP=1
PROJECTPULSE_BACKUP_INTERVAL_SECONDS=86400
PROJECTPULSE_BACKUP_RETENTION_DAYS=30
BACKUP_PATH=
PROJECTPULSE_MAIL_HOST=smtp.example.com
PROJECTPULSE_MAIL_PORT=587
PROJECTPULSE_MAIL_FROM=ProjectPulse <noreply@example.com>
PROJECTPULSE_MAIL_USERNAME=
PROJECTPULSE_MAIL_PASSWORD=
PROJECTPULSE_MAIL_USE_TLS=1
PROJECTPULSE_SENTRY_DSN=
PROJECTPULSE_OPERATOR_NAME=SET-OPERATOR-NAME
PROJECTPULSE_SUPPORT_EMAIL=SET-SUPPORT-EMAIL
PROJECTPULSE_HOSTING_LOCATION=SET-HOSTING-LOCATION
PROJECTPULSE_RETENTION_PERIOD=SET-RETENTION-PERIOD
PROJECTPULSE_DELETION_PROCESS=SET-DELETION-PROCESS
